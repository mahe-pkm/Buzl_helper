datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  role         String    @default("worker")
  assignedProducts Product[]
  actionLogs   ProductActionLog[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
}

model Product {
  id             String   @id @default(cuid())
  product_name   String
  category       String?
  drive_folder   String
  reference_link String?
  thumbnail_url  String?
  reference_thumbnail_url String?
  thumbnail_cached_data String?
  reference_thumbnail_cached_data String?
  status         String   @default("pending")
  current_phase  String   @default("none")
  regen_image_count Int   @default(0)
  generated_image_count Int @default(0)
  full_regen_image_count Int @default(0)
  notes          String?
  assigned_to    String?
  assignedAt     DateTime?
  lastActivityAt DateTime @default(now())
  assignee       User?    @relation(fields: [assigned_to], references: [id])
  last_action    String?
  actionLogs     ProductActionLog[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model ProductActionLog {
  id        String   @id @default(cuid())
  productId String
  userId    String?
  action    String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([userId, createdAt])
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}
