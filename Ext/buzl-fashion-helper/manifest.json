{
  "manifest_version": 3,
  "name": "Buzl Fashion Helper",
  "version": "1.0.0",
  "minimum_chrome_version": "114",
  "description": "Chrome Side Panel Extension designed for high-speed fashion product workflows.",
  "permissions": [
    "storage",
    "sidePanel",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://docs.google.com/*",
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "favicon-16.png",
    "32": "favicon-32.png",
    "48": "favicon-48.png",
    "128": "favicon-128.png"
  },
  "action": {
    "default_title": "Open Buzl Fashion Helper",
    "default_popup": "index.html",
    "default_icon": {
      "16": "favicon-16.png",
      "32": "favicon-32.png",
      "48": "favicon-48.png",
      "128": "favicon-128.png"
    }
  }
}
